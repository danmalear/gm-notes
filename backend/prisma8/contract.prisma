// use prisma-8
namespace public {
  model AbilityCheck {
    AbilityCheckId             Uuid           @id
    ActionId                   Uuid
    Action                     Action         @relation(fields: [ActionId], references: [ActionId], onUpdate: Cascade, onDelete: Cascade)
    Skill                      pg.enum(Skill)
    DC                         Int
    SuccessNarrationId         Uuid?
    SuccessNarration           Narration?     @relation(name: "Success", fields: [SuccessNarrationId], references: [NarrationId], onUpdate: Cascade, onDelete: SetNull)
    FailureNarrationId         Uuid?
    FailureNarration           Narration?     @relation(name: "Failure", fields: [FailureNarrationId], references: [NarrationId], onUpdate: Cascade, onDelete: SetNull)
    CriticalSuccessNarrationId Uuid?
    CriticalSuccessNarration   Narration?     @relation(name: "CriticalSuccess", fields: [CriticalSuccessNarrationId], references: [NarrationId], onUpdate: Cascade, onDelete: SetNull)
    CriticalFailureNarrationId Uuid?
    CriticalFailureNarration   Narration?     @relation(name: "CriticalFailure", fields: [CriticalFailureNarrationId], references: [NarrationId], onUpdate: Cascade, onDelete: SetNull)
  }

  model Action {
    ActionId         Uuid                 @id
    TargetId         Uuid
    Target           IActionTarget        @relation(fields: [TargetId], references: [IActionTargetId], onUpdate: Cascade, onDelete: Cascade)
    Name             String
    Type             pg.enum(ActionType)?
    NarrationId      Uuid?
    Narration        Narration?           @relation(fields: [NarrationId], references: [NarrationId], onUpdate: Cascade, onDelete: SetNull)
    AbilityChecks    AbilityCheck[]
    ActionConditions ActionCondition[]
  }

  model ActionCondition {
    ActionId    Uuid      @map("ActionId")
    Action      Action    @relation(fields: [ActionId], references: [ActionId], onUpdate: Cascade, onDelete: Cascade)
    ConditionId Uuid      @map("ConditionId")
    Condition   Condition @relation(fields: [ConditionId], references: [ConditionId], onUpdate: Cascade, onDelete: Cascade)

    @@id([ActionId, ConditionId])
  }

  model Campaign {
    CampaignId         Uuid        @id
    CampaignTemplateId Uuid?
    Name               String
    ActiveMapId        Uuid?       @unique
    ActiveMap          Map?        @relation(name: "CampaignActiveMap", fields: [ActiveMapId], references: [MapId], onUpdate: Cascade, onDelete: SetNull)
    Conditions         Condition[]
    Handouts           Handout[]
    Items              Item[]
    Maps               Map[]       @relation(name: "MapCampaign")
  }

  model CampaignTemplate {
    CampaignTemplateId Uuid        @id
    Name               VarChar(63)
  }

  model Condition {
    ConditionId      Uuid              @id
    Name             String
    Description      String
    IsMet            Boolean           @default(false)
    CampaignId       Uuid
    Campaign         Campaign          @relation(fields: [CampaignId], references: [CampaignId], onUpdate: Cascade, onDelete: Cascade)
    ActionConditions ActionCondition[]
  }

  model File {
    FileId   Uuid   @id
    FileName String
    Items    Item[]
    Maps     Map[]
  }

  model Handout {
    HandoutId      Uuid                 @id
    CampaignId     Uuid
    Campaign       Campaign             @relation(fields: [CampaignId], references: [CampaignId], onUpdate: Cascade, onDelete: Cascade)
    Name           String
    Type           pg.enum(HandoutType)
    Source         String
    RegionHandouts RegionHandout[]
  }

  model IActionTarget {
    IActionTargetId Uuid                      @id
    Type            pg.enum(ActionTargetType)
    Actions         Action[]
    Region          Region?                   @relation(name: "RegionActionTarget")
    Item            Item?                     @relation(name: "ItemActionTarget")
    LocationItem    LocationItem?             @relation(name: "LocationItemActionTarget")
  }

  model IItemLocation {
    IItemLocationId Uuid                      @id
    Type            pg.enum(ItemLocationType)
    Items           LocationItem[]            @relation(name: "ItemLocation")
    Region          Region?                   @relation(name: "RegionItemLocation")
    LocationItem    LocationItem?             @relation(name: "LocationItemSelf")
  }

  model INoteEntity {
    INoteEntityId Uuid                    @id
    Type          pg.enum(NoteEntityType)
    Notes         Note[]
    Region        Region?                 @relation(name: "RegionNoteEntity")
    Item          Item?                   @relation(name: "ItemNoteEntity")
    LocationItem  LocationItem?           @relation(name: "LocationItemNoteEntity")
  }

  model Item {
    ItemId        Uuid                   @id
    IActionTarget IActionTarget          @relation(name: "ItemActionTarget", fields: [ItemId], references: [IActionTargetId], onUpdate: Cascade, onDelete: Restrict, map: "Item_IActionTarget_fkey")
    INoteEntity   INoteEntity            @relation(name: "ItemNoteEntity", fields: [ItemId], references: [INoteEntityId], onUpdate: Cascade, onDelete: Restrict, map: "Item_INoteEntity_fkey")
    CampaignId    Uuid
    Campaign      Campaign               @relation(fields: [CampaignId], references: [CampaignId], onUpdate: Cascade, onDelete: Cascade)
    Name          String
    IsContainer   Boolean                @default(false)
    Value         Int?
    ValueUnit     pg.enum(CurrencyUnit)?
    DetailsLink   String?
    ImageFileId   Uuid?
    ImageFile     File?                  @relation(fields: [ImageFileId], references: [FileId], onUpdate: Cascade, onDelete: SetNull)
    LocationItems LocationItem[]
  }

  model LocationItem {
    LocationItemId Uuid          @id
    IActionTarget  IActionTarget @relation(name: "LocationItemActionTarget", fields: [LocationItemId], references: [IActionTargetId], onUpdate: Cascade, onDelete: Restrict, map: "LocationItem_IActionTarget_fkey")
    IItemLocation  IItemLocation @relation(name: "LocationItemSelf", fields: [LocationItemId], references: [IItemLocationId], onUpdate: Cascade, onDelete: Restrict, map: "LocationItem_IItemLocation_fkey")
    INoteEntity    INoteEntity   @relation(name: "LocationItemNoteEntity", fields: [LocationItemId], references: [INoteEntityId], onUpdate: Cascade, onDelete: Restrict, map: "LocationItem_INoteEntity_fkey")
    LocationId     Uuid
    Location       IItemLocation @relation(name: "ItemLocation", fields: [LocationId], references: [IItemLocationId], onUpdate: Cascade, onDelete: Cascade)
    ItemId         Uuid
    Item           Item          @relation(fields: [ItemId], references: [ItemId], onUpdate: Cascade, onDelete: Cascade)
    Quantity       Int           @default(1)
  }

  model Map {
    MapId           Uuid                      @id
    CampaignId      Uuid
    Campaign        Campaign                  @relation(name: "MapCampaign", fields: [CampaignId], references: [CampaignId], onUpdate: Cascade, onDelete: Cascade)
    MapTemplateId   Uuid?
    Name            String
    ImageFileId     Uuid
    ImageFile       File                      @relation(fields: [ImageFileId], references: [FileId], onUpdate: Cascade, onDelete: Restrict)
    DefaultLighting pg.enum(AbsoluteLighting) @default("Bright Light")
    Width           Int                       @default(0)
    Height          Int                       @default(0)
    ActiveCampaign  Campaign?                 @relation(name: "CampaignActiveMap")
    Regions         Region[]
  }

  model MapTemplate {
    MapTemplateId      Uuid         @id
    CampaignTemplateId Uuid?
    Name               VarChar(63)
    ImagePath          VarChar(255)
  }

  model Narration {
    NarrationId                  Uuid              @id
    NarrationTemplateId          Uuid?
    Name                         String
    Description                  String
    IsRead                       Boolean           @default(false)
    Actions                      Action[]
    RegionNarrations             RegionNarration[]
    SuccessAbilityChecks         AbilityCheck[]    @relation(name: "Success")
    FailureAbilityChecks         AbilityCheck[]    @relation(name: "Failure")
    CriticalSuccessAbilityChecks AbilityCheck[]    @relation(name: "CriticalSuccess")
    CriticalFailureAbilityChecks AbilityCheck[]    @relation(name: "CriticalFailure")
  }

  model NarrationTemplate {
    NarrationTemplateId Uuid         @id
    Name                VarChar(255)
    Description         VarChar(255)
  }

  model Note {
    NoteId      Uuid        @id
    EntityId    Uuid
    INoteEntity INoteEntity @relation(fields: [EntityId], references: [INoteEntityId], onUpdate: Cascade, onDelete: Cascade)
    Description String
  }

  model Region {
    RegionId         Uuid                      @id
    IActionTarget    IActionTarget             @relation(name: "RegionActionTarget", fields: [RegionId], references: [IActionTargetId], onUpdate: Cascade, onDelete: Restrict, map: "Region_IActionTarget_fkey")
    IItemLocation    IItemLocation             @relation(name: "RegionItemLocation", fields: [RegionId], references: [IItemLocationId], onUpdate: Cascade, onDelete: Restrict, map: "Region_IItemLocation_fkey")
    INoteEntity      INoteEntity               @relation(name: "RegionNoteEntity", fields: [RegionId], references: [INoteEntityId], onUpdate: Cascade, onDelete: Restrict, map: "Region_INoteEntity_fkey")
    RegionTemplateId Uuid?
    MapId            Uuid
    Map              Map                       @relation(fields: [MapId], references: [MapId], onUpdate: Cascade, onDelete: Cascade)
    Name             String
    Lighting         pg.enum(RelativeLighting) @default("Default")
    Handouts         RegionHandout[]
    Narrations       RegionNarration[]
    Shapes           RegionShape[]
  }

  model RegionHandout {
    RegionId  Uuid
    Region    Region  @relation(fields: [RegionId], references: [RegionId], onUpdate: Cascade, onDelete: Cascade)
    HandoutId Uuid
    Handout   Handout @relation(fields: [HandoutId], references: [HandoutId], onUpdate: Cascade, onDelete: Cascade)

    @@id([RegionId, HandoutId], map: "RegionHandout_pkey")
  }

  model RegionNarration {
    RegionId    Uuid
    Region      Region    @relation(fields: [RegionId], references: [RegionId], onUpdate: Cascade, onDelete: Cascade)
    NarrationId Uuid
    Narration   Narration @relation(fields: [NarrationId], references: [NarrationId], onUpdate: Cascade, onDelete: Cascade)

    @@id([RegionId, NarrationId], map: "RegionNarration_pkey")
  }

  model RegionShape {
    RegionShapeId Uuid               @id
    RegionId      Uuid
    Region        Region             @relation(fields: [RegionId], references: [RegionId], onUpdate: Cascade, onDelete: Cascade)
    Coords        Jsonb
    ShapeType     pg.enum(ShapeType)
  }

  model RegionTemplate {
    RegionTemplateId Uuid        @id
    MapTemplateId    Uuid
    Name             VarChar(63)
  }

  native_enum AbsoluteLighting {
    Darkness = "Darkness"
    DimLight = "Dim Light"
    BrightLight = "Bright Light"
  }

  native_enum ActionTargetType {
    Item = "Item"
    LocationItem = "LocationItem"
    Region = "Region"
  }

  native_enum ActionType {
    Attack = "Attack"
    Dash = "Dash"
    Disengage = "Disengage"
    Dodge = "Dodge"
    Help = "Help"
    Hide = "Hide"
    Influence = "Influence"
    Magic = "Magic"
    Ready = "Ready"
    Search = "Search"
    Study = "Study"
    Utilize = "Utilize"
  }

  native_enum CurrencyUnit {
    CP = "CP"
    SP = "SP"
    EP = "EP"
    GP = "GP"
    PP = "PP"
  }

  native_enum HandoutType {
    Text = "Text"
    Image = "Image"
    File = "File"
  }

  native_enum ItemLocationType {
    Region = "Region"
    LocationItem = "LocationItem"
  }

  native_enum NoteEntityType {
    Item = "Item"
    LocationItem = "LocationItem"
    Region = "Region"
  }

  native_enum RelativeLighting {
    Darkness = "Darkness"
    DimLight = "Dim Light"
    BrightLight = "Bright Light"
    Default = "Default"
    DefaultPlus = "Default+"
    DefaultMinus = "Default-"
  }

  native_enum ShapeType {
    Circle = "Circle"
    Polygon = "Polygon"
    Rectangle = "Rectangle"
  }

  native_enum Skill {
    Acrobatics = "Acrobatics"
    AnimalHandling = "Animal Handling"
    Arcana = "Arcana"
    Athletics = "Athletics"
    Deception = "Deception"
    History = "History"
    Insight = "Insight"
    Intimidation = "Intimidation"
    Investigation = "Investigation"
    Medicine = "Medicine"
    Nature = "Nature"
    Perception = "Perception"
    Performance = "Performance"
    Persuasion = "Persuasion"
    Religion = "Religion"
    SleightOfHand = "Sleight of Hand"
    Stealth = "Stealth"
    Survival = "Survival"
  }
}

namespace es {
  model Command {
    CommandId     Uuid                                  @id
    StreamId      Uuid?
    CorrelationId Uuid
    Context       String
    Ref           String
    Data          Jsonb
    CreatedAt     Raw(sql`timestamp(6) with time zone`)
  }

  model Event {
    EventId       Uuid                                  @id
    StreamId      Uuid
    CorrelationId Uuid
    Context       String
    Ref           String
    Version       Int
    Data          Jsonb
    OccurredAt    Raw(sql`timestamp(6) with time zone`)
  }

  model Stream {
    StreamId  Uuid                                  @id
    Type      String
    Version   Int                                   @default(0)
    CreatedAt Raw(sql`timestamp(6) with time zone`)
    UpdatedAt Raw(sql`timestamp(6) with time zone`)
  }
}
